# Example environment variables for taosc-llm
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=your_base_url/v1_here
OPENAI_MODEL=your_model_here
TAOSC_LLM_CONTEXT_WINDOW=400000
TAOSC_LLM_MAX_TOKENS=100000
TAOSC_LLM_TIMEOUT_SECONDS=3600
TAOSC_LLM_MAX_TURNS=128
TAOSC_LLM_MAX_TOOL_CALLS=256
# Optional: minimal, low, medium, high, xhigh, max. Omit for provider defaults.
# TAOSC_LLM_REASONING_EFFORT=high